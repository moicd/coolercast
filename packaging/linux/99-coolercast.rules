# CoolerCast: give the logged-in user access to DeepCool cooler displays (vendor 0x3633) and the
# CH510 MESH DIGITAL case display (0x34D3:0x1100), so `coolercast list`, `test` and `probe` work
# without sudo. The service runs as root anyway.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3633", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="34d3", ATTRS{idProduct}=="1100", MODE="0660", TAG+="uaccess"
